<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BitwardenSharp.Desktop.ViewModels"
             xmlns:views="clr-namespace:BitwardenSharp.Desktop.Views"
             x:Class="BitwardenSharp.Desktop.Views.DuplicatesView"
             x:DataType="vm:DuplicatesViewModel">

  <Panel>
    <!-- ── the queue ───────────────────────────────────────────────────── -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

      <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <Button Grid.Column="0" Content="‹ Vault" Command="{Binding CloseCommand}" />
          <TextBlock Grid.Column="1" Text="Duplicates" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="16,0,0,0" />
          <TextBlock Grid.Column="2" Text="{Binding StatusLine}" Opacity="0.6" FontSize="12"
                     VerticalAlignment="Center" Margin="16,0,0,0" />
          <Button Grid.Column="3" Content="Rescan" Command="{Binding RefreshCommand}" />
        </Grid>
      </Border>

      <!-- summary + bulk action -->
      <Border Grid.Row="1" Padding="12,10"
              Background="{DynamicResource SystemControlBackgroundListLowBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock FontSize="13">
              <Run Text="{Binding RoutineCount}" />
              <Run Text="routine —" />
              <Run Text="{Binding PendingDeletions}" />
              <Run Text="deletions, no credential changes" />
            </TextBlock>
            <TextBlock FontSize="11" Opacity="0.6">
              <Run Text="{Binding AttentionCount}" />
              <Run Text="need a decision — open those in the editor" />
            </TextBlock>
          </StackPanel>
          <Button Grid.Column="1" Classes="accent" Content="Approve all routine"
                  Command="{Binding ApproveAllRoutineCommand}" />
        </Grid>
      </Border>

      <Border Grid.Row="2" Padding="12,6" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="3">
        <ItemsControl ItemsSource="{Binding VisibleGroups}" Margin="12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
              <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" BorderThickness="1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">

                  <Panel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Width="24" Height="24"
                         Margin="0,0,12,0" VerticalAlignment="Top">
                    <Border CornerRadius="5" Background="{Binding Survivor.PlaceholderBrush}"
                            IsVisible="{Binding Survivor.ShowPlaceholder}">
                      <TextBlock Text="{Binding Survivor.Initial}" Foreground="White" FontSize="12"
                                 FontWeight="SemiBold" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Survivor.Icon}" Width="24" Height="24" />
                  </Panel>

                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Id}" FontFamily="monospace" FontSize="11" Opacity="0.5"
                               VerticalAlignment="Center" />
                    <Border Padding="6,1" CornerRadius="3"
                            Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                      <TextBlock Text="{Binding CategoryLabel}" FontSize="10" Opacity="0.8" />
                    </Border>
                    <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </StackPanel>

                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlanSummary}"
                             Opacity="0.6" FontSize="12" Margin="0,3,0,0" />

                  <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                              Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateGlyph}" FontSize="16" VerticalAlignment="Center"
                               Opacity="0.7" />
                    <Button Content="Open editor"
                            IsEnabled="{Binding IsPending}"
                            Command="{Binding $parent[ItemsControl].((vm:DuplicatesViewModel)DataContext).OpenEditorCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Approve" Classes="accent"
                            IsEnabled="{Binding IsPending}"
                            Command="{Binding $parent[ItemsControl].((vm:DuplicatesViewModel)DataContext).ApproveCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>

                  <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                             FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource SystemFillColorCautionBrush}"
                             IsVisible="{Binding HasWarnings}"
                             Text="{Binding WarningSummary}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="4" Padding="12,6" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
          <CheckBox Grid.Column="0" Content="Routine" IsChecked="{Binding ShowRoutine}" />
          <CheckBox Grid.Column="1" Content="Needs a decision" Margin="12,0,0,0"
                    IsChecked="{Binding ShowReviewOnly}" />
          <CheckBox Grid.Column="2" Content="Show resolved" Margin="12,0,0,0"
                    IsChecked="{Binding ShowResolved}" />
          <TextBlock Grid.Column="3" Text="{Binding Progress}" Opacity="0.6" FontSize="11"
                     VerticalAlignment="Center" Margin="16,0,0,0" />
          <ProgressBar Grid.Column="4" Width="120" Height="3" IsIndeterminate="True"
                       IsVisible="{Binding IsBusy}" />
        </Grid>
      </Border>
    </Grid>

    <!-- ── the editor, over the queue ──────────────────────────────────── -->
    <Border IsVisible="{Binding IsEditorOpen}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <views:MergeEditorView DataContext="{Binding Editor}" />
    </Border>
  </Panel>
</UserControl>
