<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BitwardenSharp.Desktop.ViewModels"
             x:Class="BitwardenSharp.Desktop.Views.VaultView"
             x:DataType="vm:VaultViewModel"
             DragDrop.AllowDrop="True">

  <UserControl.Resources>
    <vm:DropTargetBrushConverter x:Key="DropTargetBrush" />
    <!-- Icon or placeholder, shared by the list and the detail header. The Image sits on top of
         the placeholder rather than replacing it, so there is no layout shift when one arrives. -->
    <DataTemplate x:Key="ItemIcon" x:DataType="vm:ItemViewModel">
      <Panel Width="24" Height="24">
        <Border CornerRadius="5" Background="{Binding PlaceholderBrush}"
                IsVisible="{Binding ShowPlaceholder}">
          <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Image Source="{Binding Icon}" Width="24" Height="24" />
      </Panel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ── toolbar ─────────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="BitwardenSharp"
                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBox Grid.Column="1" PlaceholderText="Search name, username or URI"
                 Text="{Binding Search}" MaxWidth="460" HorizontalAlignment="Left" />
        <Button Grid.Column="2" Content="Duplicates" Margin="8,0,0,0"
                Command="{Binding OpenDuplicatesCommand}" />
        <Button Grid.Column="3" Content="Refresh" Margin="8,0,0,0"
                Command="{Binding RefreshCommand}" />
        <Button Grid.Column="4" Content="Lock" Margin="8,0,0,0"
                Command="{Binding LockCommand}" />
      </Grid>
    </Border>

    <!-- ── error banner ────────────────────────────────────────────────── -->
    <Border Grid.Row="1" Padding="12,8"
            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
            IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Error}" TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
      </Grid>
    </Border>

    <!-- ── three panes ─────────────────────────────────────────────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="270,4,330,4,*">

      <!-- folders -->
      <DockPanel x:Name="FolderPane" Grid.Column="0" Margin="8" DragDrop.AllowDrop="True">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <Button Grid.Column="0" Content="All items"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding ClearFolderCommand}" />
          <Button Grid.Column="1" Content="＋" Margin="4,0,0,0" ToolTip.Tip="New folder"
                  Command="{Binding NewFolderCommand}" />
        </Grid>

        <TreeView ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}">
          <TreeView.Styles>
            <!-- Two-way, so collapsing a node in the UI sticks across a reload. -->
            <Style Selector="TreeViewItem" x:DataType="vm:FolderNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.Styles>

          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FolderNode">
              <!-- Tinted while a drag hovers, so the drop target is unambiguous. -->
              <Border CornerRadius="4" Padding="4,2"
                      Background="{Binding IsDropTarget, Converter={StaticResource DropTargetBrush}}"
                      DragDrop.AllowDrop="True"
                      PointerPressed="OnDragSourcePressed"
                      PointerMoved="OnDragSourceMoved"
                      PointerReleased="OnDragSourceReleased">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                             Text="📁" IsVisible="{Binding !IsUnfiled}" />
                  <TextBlock Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                             Text="🗂" IsVisible="{Binding IsUnfiled}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Opacity="0.45"
                             FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>

                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="New folder here"
                              Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).NewFolderCommand}" />
                    <MenuItem Header="Rename…"
                              Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).RenameFolderCommand}" />
                    <Separator />
                    <MenuItem Header="Delete folder"
                              Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).DeleteFolderCommand}" />
                  </ContextMenu>
                </Border.ContextMenu>
              </Border>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="Transparent" />

      <!-- item list -->
      <DockPanel Grid.Column="2" Margin="0,8,8,8">
        <TextBlock DockPanel.Dock="Top" Margin="4,0,0,6" Opacity="0.6" FontSize="12">
          <Run Text="{Binding FilterDescription}" />
          <Run Text=" — " />
          <Run Text="{Binding Items.Count}" />
          <Run Text=" shown · drag onto a folder to move" />
        </TextBlock>

        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ItemViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3"
                    Background="Transparent"
                    PointerPressed="OnDragSourcePressed"
                    PointerMoved="OnDragSourceMoved"
                    PointerReleased="OnDragSourceReleased">
                <ContentControl Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"
                                Content="{Binding}" ContentTemplate="{StaticResource ItemIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Opacity="0.55" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="★" Foreground="#E0A22C" VerticalAlignment="Center"
                           IsVisible="{Binding Favorite}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="3" Background="Transparent" />

      <!-- detail -->
      <ScrollViewer Grid.Column="4" Margin="0,8,8,8"
                    IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="14" DataContext="{Binding SelectedItem}" x:DataType="vm:ItemViewModel">

          <Grid ColumnDefinitions="Auto,*,Auto">
            <ContentControl Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"
                            Content="{Binding}" ContentTemplate="{StaticResource ItemIcon}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Type}" Opacity="0.5" FontSize="12" />
            </StackPanel>
            <ToggleButton Grid.Column="2" Content="Reveal" VerticalAlignment="Center"
                          IsChecked="{Binding IsSecretVisible}" />
          </Grid>

          <Border Padding="8,6" CornerRadius="4"
                  Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                  IsVisible="{Binding RequiresReprompt}">
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Text="Bitwarden marks this item master-password reprompt." />
          </Border>

          <!-- login -->
          <StackPanel Spacing="4" IsVisible="{Binding HasUsername}">
            <TextBlock Text="USERNAME" FontSize="10" Opacity="0.5" />
            <SelectableTextBlock Text="{Binding Username}" FontFamily="monospace" />
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding IsLogin}">
            <TextBlock Text="PASSWORD" FontSize="10" Opacity="0.5" />
            <SelectableTextBlock Text="{Binding PasswordDisplay}" FontFamily="monospace"
                                 TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding HasTotp}">
            <TextBlock Text="TOTP" FontSize="10" Opacity="0.5" />
            <TextBlock Text="a second factor is stored on this item" Opacity="0.7" FontSize="12" />
          </StackPanel>

          <!-- card -->
          <StackPanel Spacing="6" IsVisible="{Binding HasCard}">
            <TextBlock Text="CARD" FontSize="10" Opacity="0.5" />
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Cardholder" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="0" Grid.Column="1" FontSize="12"
                                   Text="{Binding Card.CardholderName}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Brand" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Text="{Binding Card.Brand}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Number" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" FontFamily="monospace" FontSize="12"
                                   Text="{Binding CardNumberDisplay}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Expiry / CVV" Opacity="0.6" FontSize="12" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <SelectableTextBlock FontFamily="monospace" FontSize="12" Text="{Binding Card.Expiry}" />
                <SelectableTextBlock FontFamily="monospace" FontSize="12" Text="{Binding CardCodeDisplay}" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <!-- identity -->
          <StackPanel Spacing="6" IsVisible="{Binding HasIdentity}">
            <TextBlock Text="IDENTITY" FontSize="10" Opacity="0.5" />
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="0" Grid.Column="1" FontSize="12"
                                   Text="{Binding Identity.FullName}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Email" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Text="{Binding Identity.Email}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Phone" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Text="{Binding Identity.Phone}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Address" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" FontSize="12"
                                   Text="{Binding Identity.Address}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Company" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="4" Grid.Column="1" FontSize="12"
                                   Text="{Binding Identity.Company}" />
            </Grid>
          </StackPanel>

          <!-- ssh key -->
          <StackPanel Spacing="6" IsVisible="{Binding HasSshKey}">
            <TextBlock Text="SSH KEY" FontSize="10" Opacity="0.5" />
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Algorithm" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="0" Grid.Column="1" FontSize="12"
                                   Text="{Binding SshKey.Algorithm}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Fingerprint" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontFamily="monospace" FontSize="11"
                                   Text="{Binding SshKey.KeyFingerprint}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Private key" Opacity="0.6" FontSize="12" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" FontFamily="monospace" FontSize="10"
                                   Text="{Binding SshPrivateKeyDisplay}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>

          <!-- uris -->
          <StackPanel Spacing="4" IsVisible="{Binding HasUris}">
            <TextBlock Text="URIS" FontSize="10" Opacity="0.5" />
            <ItemsControl ItemsSource="{Binding Uris}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <SelectableTextBlock Text="{Binding Uri}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- custom fields -->
          <StackPanel Spacing="4" IsVisible="{Binding HasFields}">
            <TextBlock Text="CUSTOM FIELDS" FontSize="10" Opacity="0.5" />
            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="160,*" Margin="0,1">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Opacity="0.7" FontSize="12" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                         TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- attachments -->
          <StackPanel Spacing="4" IsVisible="{Binding HasAttachments}">
            <TextBlock Text="ATTACHMENTS" FontSize="10" Opacity="0.5" />
            <ItemsControl ItemsSource="{Binding Attachments}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding FileName}" FontSize="12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- notes -->
          <StackPanel Spacing="4" IsVisible="{Binding HasNotes}">
            <TextBlock Text="NOTES" FontSize="10" Opacity="0.5" />
            <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>

          <!-- password history: dates only. The old passwords are deliberately not rendered. -->
          <StackPanel Spacing="4" IsVisible="{Binding HasPasswordHistory}">
            <TextBlock Text="PASSWORD HISTORY" FontSize="10" Opacity="0.5" />
            <ItemsControl ItemsSource="{Binding PasswordHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontSize="11" Opacity="0.7" Margin="0,1"
                             Text="{Binding LastUsedDate, StringFormat='changed {0:d MMM yyyy}'}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Opacity="0.4" FontSize="11">
            <Run Text="last changed " />
            <Run Text="{Binding Revised}" />
          </TextBlock>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── status bar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="3" Padding="12,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusLine}" Opacity="0.6" FontSize="11"
                   VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Width="120" Height="3" IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
